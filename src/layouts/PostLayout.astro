---
import Layout from '../layouts/Layout.astro'
import { formatDistance } from 'date-fns'
import { Image } from 'astro:assets'

const { content, headings = [] } = Astro.props
const {
  title,
  summary,
  publish_date,
  hide_feat_image = false,
  feat_image,
} = content

// Astro puts a slug id on every rendered heading, so depth-2 entries can link
// straight to them. A few posts carry a stray U+FEFF inside the heading text.
const toc = headings
  .filter((heading) => heading.depth === 2)
  .map((heading) => ({
    ...heading,
    text: heading.text.replace(/\uFEFF/g, '').trim(),
  }))

const getMediaFormat = (feat_image) => {
  return feat_image.split('.')[1]
}
---

<Layout>
  <article class="dark:text-zinc-300">
    <header class="flex flex-col">
      <h1
        class="mt-2 text-3xl font-bold tracking-tight text-zinc-800 sm:text-5xl dark:text-zinc-100"
      >
        {title}
      </h1>
      <time
        datetime="2022-09-05"
        class="order-first flex items-center text-base text-zinc-400 dark:text-zinc-500"
      >
        <span class="h-4 w-0.5 rounded-full bg-zinc-200 dark:bg-zinc-500"
        ></span>
        <span class="ml-3"
          >{
            formatDistance(new Date(publish_date), new Date(), {
              addSuffix: true,
            })
          }</span
        >
      </time>
    </header>
    {
      feat_image &&
        !hide_feat_image &&
        (getMediaFormat(feat_image) === 'gif' ? (
          <img
            src={feat_image}
            class="mt-8 flex rounded-xl overflow-hidden w-full"
          />
        ) : (
          <Image
            src={feat_image}
            alt="A description of my image."
            class="mt-8 flex rounded-xl overflow-hidden w-full"
          />
        ))
    }
    <div class="mt-8 lg:flex lg:items-start lg:gap-12">
      <div class="prose">
        <slot />
      </div>
      {
        toc.length > 0 && (
          <nav
            data-toc
            aria-label="On this page"
            class="hidden lg:sticky lg:top-8 lg:block lg:w-56 lg:shrink-0"
          >
            <p class="text-sm font-semibold text-zinc-800 dark:text-zinc-100">
              On this page
            </p>
            <ul class="mt-3 border-l border-zinc-200 dark:border-zinc-700">
              {toc.map((heading) => (
                <li>
                  <a
                    href={`#${heading.slug}`}
                    class="c-Toc__link -ml-px block border-l border-transparent py-1 pl-4 text-sm text-zinc-500 transition hover:border-indigo-800 hover:text-indigo-800 dark:text-zinc-400 dark:hover:border-indigo-300 dark:hover:text-indigo-300"
                  >
                    {heading.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
    </div>
  </article>
</Layout>

<script>
  // Highlights the TOC entry for the section currently being read. Astro hoists
  // this script onto every post, so it no-ops when the page has no TOC.
  const nav = document.querySelector('[data-toc]')

  if (nav) {
    const sections = [...nav.querySelectorAll('a[href^="#"]')]
      .map((link) => {
        const id = (link.getAttribute('href') || '').slice(1)
        const heading = id ? document.getElementById(id) : null
        return heading ? { link, heading } : null
      })
      .filter((section) => section !== null)

    if (sections.length > 0) {
      // Sits below the nav's own sticky offset, so a heading reached by
      // clicking a TOC link (which lands at scroll-margin-top: 2rem) counts
      // as active rather than sitting just above the line.
      const ACTIVATION_LINE = 96
      let active
      let frame = null

      const update = () => {
        frame = null

        // The active section is the last one whose heading has crossed the
        // line; nothing is active while still above the first heading.
        let current = null
        for (const section of sections) {
          if (section.heading.getBoundingClientRect().top > ACTIVATION_LINE) break
          current = section
        }

        // A short final section may never cross the line before the page
        // bottoms out, so claim it once there is nowhere left to scroll.
        const scrollBottom = window.scrollY + window.innerHeight
        if (scrollBottom >= document.documentElement.scrollHeight - 2) {
          current = sections[sections.length - 1]
        }

        if (current === active) return
        active = current

        for (const section of sections) {
          if (section === current) {
            section.link.setAttribute('aria-current', 'true')
          } else {
            section.link.removeAttribute('aria-current')
          }
        }
      }

      const schedule = () => {
        frame ??= requestAnimationFrame(update)
      }

      addEventListener('scroll', schedule, { passive: true })
      addEventListener('resize', schedule)
      update()
    }
  }
</script>
