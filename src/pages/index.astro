import ExtraStuff from '../components/home/ExtraStuff.astro';
import Mastodon from '../components/home/Mastodon.astro';
import FeaturedMedia from '../components/home/FeaturedMedia.astro';
---

<Layout>
  <Intro />
  <div class="block h-116">
    <div class="contents relative mt-12">
      <div class="absolute w-full left-0">
        <FeaturedMedia />
      </div>
    </div>
  </div>
  <ExtraStuff />
  <Mastodon />
</Layout>
