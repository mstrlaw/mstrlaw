# Cloudflare Workers Static Assets defaults every asset to
#   Cache-Control: public, max-age=0, must-revalidate
# which costs a revalidation round trip per asset on every repeat visit.
# These rules replace that default wherever the URL is safe to cache.
#
# This file does not affect responses generated by worker/index.js
# (/api/wakatime sets its own Cache-Control).

# Astro fingerprints these filenames, so the URL changes whenever the
# content does. Safe to cache indefinitely.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Not fingerprinted and re-encoded from time to time, so keep a short
# fresh window and serve stale while a new copy is fetched.
/photos/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/icons/*
  Cache-Control: public, max-age=2592000

/favicon/*
  Cache-Control: public, max-age=2592000

/social_banner.png
  Cache-Control: public, max-age=2592000
